# Copy this file to .env and fill in your values.
# Never commit .env to git.

# OpenAI API key (required)
OPENAI_API_KEY=your_openai_api_key_here

# Ethereum mainnet RPC URL — needs archive access for fork tests (required)
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID

# Path to your local Foundry project root (where foundry.toml lives).
# Default: this repo's root (only works if you have Foundry set up here).
# Set to your DeFiHackLabs clone path for full exploit reproduction.
# Example: FOUNDRY_ROOT=/home/youruser/aismartcontractagent/DeFiHackLabs
FOUNDRY_ROOT=

# Optional overrides
# MODEL=gpt-4o
# TEMPERATURE=0.2
# MAX_ITERATIONS=10
