# Copy this file to .env and fill in your values.
# Never commit .env to git.

# OpenAI API key (required)
OPENAI_API_KEY=your_openai_api_key_here

# Ethereum mainnet RPC URL — needs archive access for fork tests (required)
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID

# Etherscan API key — for fetching verified contract source code (required)
# Free at https://etherscan.io/register → API Keys → Add
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Path to your local Foundry project root (where foundry.toml lives).
# Defaults to the bundled foundry-workspace/ directory inside this repo.
# Override if you want to use an external project (e.g. a DeFiHackLabs clone).
# Example: FOUNDRY_ROOT=/home/youruser/aismartcontractagent/DeFiHackLabs
FOUNDRY_ROOT=foundry-workspace

# Optional overrides
# MODEL=gpt-4o
# TEMPERATURE=0.2
# MAX_ITERATIONS=10
